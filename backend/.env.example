# Copy to your shell or Render dashboard. Never commit real values.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Firebase Realtime Database (leave empty locally to use backend/instance/dev-db.json)
FIREBASE_DATABASE_URL=
# Raw JSON, base64 of the JSON, or a path to the service-account file
FIREBASE_SERVICE_ACCOUNT=

# First administrator (created at start-up if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
